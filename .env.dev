# ------------------------------
# Postgres
# ------------------------------
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_pass
POSTGRES_DB=dev_db
POSTGRES_CONTAINER_NAME=postgres_dev
POSTGRES_VOLUME_NAME=postgres_data_dev

# ------------------------------
# Java App
# ------------------------------
APP_IMAGE=ghcr.io/ppalani/trading-app
APP_VERSION=0.0.1-17028569301-build13
APP_PORT=8081

# ------------------------------
# Trading App DB Config
# ------------------------------
TRADING_DB_URL=jdbc:postgresql://db:5432/dev_db
TRADING_DB_USER=dev_user
TRADING_DB_PASS=dev_pass

# ------------------------------
# Deployment Server (Raspberry Pi)
# ------------------------------
SERVER_USER=praveenadmin
SERVER_IP=192.168.1.50  # replace with your Pi’s IP
